---
const clients = [
  'Un Jour Une Promesse',
  'De Ambre à Zen',
  "Activ' Transport",
  'HBC Salouël',
];
---

<div class="border-y border-brand-fg/8 py-16 md:py-20 px-6">
  <p class="max-w-2xl mx-auto text-center font-heading text-2xl md:text-4xl italic font-medium leading-snug text-brand-fg">
    9 client·e·s accompagné·e·s un par un,
    <span class="relative inline-block whitespace-nowrap">
      100%
      <svg viewBox="0 0 100 14" preserveAspectRatio="none" class="absolute -bottom-2 left-0 w-full h-3 text-brand-accent" aria-hidden="true">
        <path d="M2,7 Q14,2 27,7 T53,6 T79,8 T98,4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      </svg>
    </span>
    de recommandations,<br class="hidden md:block" />
    zéro univers standardisé.
  </p>

  <p class="mt-8 text-center text-brand-muted font-mono text-[10px] uppercase tracking-[0.25em]">
    {clients.map((name, i) => (
      <>
        <span>{name}</span>{i < clients.length - 1 && <span class="mx-2 text-brand-muted/40">·</span>}
      </>
    ))}
  </p>
</div>
