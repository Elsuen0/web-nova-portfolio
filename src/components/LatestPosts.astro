---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<section id="journal" class="py-28 px-6 max-w-5xl mx-auto">
  <div class="mb-14 flex flex-col md:flex-row md:items-end justify-between gap-6 scroll-reveal">
    <div>
      <span class="text-brand-muted font-mono uppercase tracking-[0.2em] text-[10px]">Journal</span>
      <h2 class="text-4xl md:text-6xl font-heading font-bold text-brand-fg mt-4 leading-[1.1] tracking-tight uppercase">
        Derniers<br/>
        <span class="text-brand-muted">articles.</span>
      </h2>
    </div>
    <a href="/blog/" class="text-xs font-mono uppercase tracking-widest text-brand-fg underline underline-offset-4 decoration-brand-fg/30 hover:decoration-brand-fg transition-colors">
      Tout le journal
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {posts.map((post, index) => (
      <a
        href={`/blog/${post.id}/`}
        class="group flex flex-col gap-3 p-6 rounded-lg bg-brand-card border border-brand-fg/6 hover:border-brand-accent/30 transition-colors scroll-reveal"
        style={`transition-delay: ${index * 80}ms`}
      >
        <span class="text-[9px] md:text-[10px] font-mono text-brand-muted uppercase tracking-widest">
          {dateFormatter.format(post.data.publishDate)}
        </span>
        <h3 class="text-lg md:text-xl font-heading font-semibold text-brand-fg tracking-tight leading-snug">
          {post.data.title}
        </h3>
        <p class="text-sm text-brand-muted font-light leading-relaxed line-clamp-3">
          {post.data.description}
        </p>
      </a>
    ))}
  </div>
</section>
