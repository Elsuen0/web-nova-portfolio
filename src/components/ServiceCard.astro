---
interface Props {
  title: string;
  description: string;
  slug: string;
  Icon: any;
  featured?: boolean;
}

const { title, description, slug, Icon, featured = false } = Astro.props;
---

{featured ? (
  <a href={`/services/${slug}`} class="group flex flex-col md:flex-row md:items-center gap-6 md:gap-10 relative p-8 md:p-12 rounded-lg bg-brand-card border border-brand-fg/8 transition-all duration-500 hover:border-brand-accent/30 hover:bg-brand-fg/3 overflow-hidden">
    <div class="absolute inset-0 bg-brand-accent/0 group-hover:bg-brand-accent/4 transition-all duration-500 rounded-lg pointer-events-none"></div>

    <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center rounded-md bg-brand-accent/8 border border-brand-fg/10 text-brand-accent shrink-0 transition-all group-hover:bg-brand-accent/15 group-hover:border-brand-accent/25">
      <Icon size={32} strokeWidth={1.5} />
    </div>

    <div class="flex-grow">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-brand-accent">À commencer par là</span>
      <h3 class="text-2xl md:text-3xl font-heading font-semibold text-brand-fg mt-1 mb-3 tracking-tight">
        {title}
      </h3>
      <p class="text-brand-muted font-light leading-relaxed max-w-xl">
        {description}
      </p>
    </div>

    <div class="hidden md:flex items-center text-brand-fg/40 text-[10px] font-mono uppercase tracking-[0.2em] group-hover:opacity-100 md:opacity-0 transition-opacity duration-300 gap-2 shrink-0">
      Découvrir l'expertise
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </a>
) : (
  <a href={`/services/${slug}`} class="group flex flex-col h-full relative p-6 md:p-8 rounded-lg bg-brand-card border border-brand-fg/8 transition-all duration-500 hover:border-brand-accent/30 hover:bg-brand-fg/3 overflow-hidden">
    <div class="absolute inset-0 bg-brand-accent/0 group-hover:bg-brand-accent/4 transition-all duration-500 rounded-lg pointer-events-none"></div>

    <div class="w-12 h-12 flex items-center justify-center rounded-md bg-brand-accent/8 border border-brand-fg/10 text-brand-accent mb-6 transition-all group-hover:bg-brand-accent/15 group-hover:border-brand-accent/25">
      <Icon size={22} strokeWidth={1.5} />
    </div>

    <h3 class="text-xl font-heading font-semibold text-brand-fg mb-3 tracking-tight">
      {title}
    </h3>

    <p class="text-brand-muted font-light leading-relaxed text-sm">
      {description}
    </p>

    <div class="mt-auto pt-8 flex items-center text-brand-fg/40 text-[10px] font-mono uppercase tracking-[0.2em] md:opacity-0 group-hover:opacity-100 transition-opacity duration-300 gap-2">
      Découvrir l'expertise
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </a>
)}

