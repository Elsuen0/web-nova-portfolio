---
const steps = [
  {
    title: "Appel découverte",
    description: "30 minutes, gratuites et sans engagement, pour comprendre votre activité, votre univers et ce dont vous avez vraiment besoin.",
  },
  {
    title: "Proposition claire",
    description: "Un périmètre et un prix définis avant que quoi que ce soit ne commence. Aucune surprise en cours de route.",
  },
  {
    title: "Création, à votre rythme",
    description: "Vous validez chaque étape clé, dans un langage que vous comprenez, sans jargon technique.",
  },
  {
    title: "Mise en ligne & suite",
    description: "Votre site est livré. Vous choisissez ensuite si vous souhaitez continuer avec un accompagnement mensuel.",
  },
];
---

<section id="deroule" class="py-28 px-6 max-w-7xl mx-auto">
  <!-- Section header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 md:gap-12 mb-14 scroll-reveal">
    <div class="max-w-2xl">
      <span class="text-brand-muted font-mono uppercase tracking-[0.2em] text-[10px]">Le déroulé</span>
      <h2 class="text-4xl md:text-6xl font-heading font-bold text-brand-fg mt-4 leading-[1.1] tracking-tight uppercase">
        Comment ça<br/>
        <span class="text-brand-muted">se passe.</span>
      </h2>
    </div>
    <p class="max-w-xs text-brand-muted font-light leading-relaxed">
      Pas de zone d'ombre : voici exactement ce qui se passe une fois que vous me contactez.
    </p>
  </div>

  <div class="space-y-3">
    {steps.map((step, i) => (
      <div class="flex items-center gap-6 md:gap-10 p-6 md:p-8 rounded-md bg-brand-fg/[0.02] border border-brand-fg/6 hover:border-brand-accent/20 transition-colors scroll-reveal"
           style={`transition-delay: ${i * 80}ms`}>
        <span class="text-4xl md:text-5xl font-heading font-medium italic text-brand-accent/30 shrink-0">0{i + 1}</span>
        <div>
          <h3 class="text-base md:text-lg font-heading font-semibold text-brand-fg tracking-tight">{step.title}</h3>
          <p class="mt-1.5 text-sm text-brand-muted font-light leading-relaxed">{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
